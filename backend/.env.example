# =============================================================================
# anotherME Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Environment: development | production
NODE_ENV=development

# Port for the Express server (default: 5000)
PORT=5000

# -----------------------------------------------------------------------------
# MongoDB Configuration
# -----------------------------------------------------------------------------
# MongoDB Atlas connection string (M0 Free Tier)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# IMPORTANT: Replace with your actual MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/anotherme?retryWrites=true&w=majority

# -----------------------------------------------------------------------------
# Session Configuration
# -----------------------------------------------------------------------------
# Session secret (MUST be changed in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-session-secret-here-change-in-production-use-64-char-random-string

# Cookie domain for production (leave empty for development)
# Production example: .yourdomain.com
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed frontend origin(s) - comma-separated for multiple origins
# Development: http://localhost:5173
# Production: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Time window for rate limiting in milliseconds (15 minutes = 900000ms)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window for read endpoints
RATE_LIMIT_MAX_REQUESTS=100

# Maximum requests per window for write endpoints
RATE_LIMIT_MAX_WRITE_REQUESTS=30

# Maximum requests per window for sensitive endpoints (auth, moderation)
RATE_LIMIT_MAX_SENSITIVE_REQUESTS=10

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Enable HTTPS redirect in production (true | false)
FORCE_HTTPS=false

# Enable request logging (true | false)
ENABLE_REQUEST_LOGGING=true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection pool size (free tier limit: 100 connections)
MONGODB_POOL_SIZE=10

# MongoDB connection timeout in milliseconds
MONGODB_CONNECT_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Cache TTL for feed responses in seconds (5 minutes = 300s)
CACHE_TTL_FEEDS=300

# Cache TTL for circle data in seconds (10 minutes = 600s)
CACHE_TTL_CIRCLES=600

# -----------------------------------------------------------------------------
# Content Configuration
# -----------------------------------------------------------------------------
# Maximum post content length in characters
MAX_POST_LENGTH=5000

# Minimum post content length in characters
MIN_POST_LENGTH=10

# Maximum comment content length in characters
MAX_COMMENT_LENGTH=1000

# Maximum comment nesting depth
MAX_COMMENT_DEPTH=3

# -----------------------------------------------------------------------------
# Deployment Configuration (Render)
# -----------------------------------------------------------------------------
# Health check endpoint path
HEALTH_CHECK_PATH=/api/health

# Graceful shutdown timeout in milliseconds
SHUTDOWN_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Cloudinary Configuration (Free Tier)
# -----------------------------------------------------------------------------
# Cloudinary Cloud Name (from Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name

# Cloudinary API Key
CLOUDINARY_API_KEY=your-api-key

# Cloudinary API Secret
CLOUDINARY_API_SECRET=your-api-secret
