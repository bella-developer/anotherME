# =============================================================================
# anotherME Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Backend API base URL (without trailing slash)
# Development: http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
# IMPORTANT: This is injected at BUILD TIME by Vite
VITE_API_BASE_URL=http://localhost:5000/api

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Application name
VITE_APP_NAME=anotherME

# Application tagline
VITE_APP_TAGLINE=a safe place for unique life

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable debug mode (shows additional logging in console)
VITE_DEBUG_MODE=false

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# -----------------------------------------------------------------------------
# UI Configuration
# -----------------------------------------------------------------------------
# Posts per page for infinite scroll
VITE_POSTS_PER_PAGE=20

# Comments per page
VITE_COMMENTS_PER_PAGE=20

# Circles per page
VITE_CIRCLES_PER_PAGE=20

# Toast notification duration in milliseconds
VITE_TOAST_DURATION=5000

# -----------------------------------------------------------------------------
# Content Limits (must match backend)
# -----------------------------------------------------------------------------
# Maximum post content length
VITE_MAX_POST_LENGTH=5000

# Minimum post content length
VITE_MIN_POST_LENGTH=10

# Maximum comment content length
VITE_MAX_COMMENT_LENGTH=1000

# Maximum comment nesting depth
VITE_MAX_COMMENT_DEPTH=3

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Cache duration for API responses in milliseconds (5 minutes = 300000ms)
VITE_CACHE_DURATION=300000

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Token storage method: localStorage | sessionStorage
# WARNING: localStorage persists across sessions, sessionStorage clears on tab close
VITE_TOKEN_STORAGE=localStorage

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------
# Google Analytics ID (leave empty to disable)
VITE_GA_ID=

# Sentry DSN for error tracking (leave empty to disable)
VITE_SENTRY_DSN=

# -----------------------------------------------------------------------------
# Deployment Configuration (Vercel)
# -----------------------------------------------------------------------------
# Build output directory (default: dist)
# This is typically configured in vite.config.js, not here
# VITE_BUILD_DIR=dist
